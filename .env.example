# Copy to .env and change the values. Never commit .env.
# SQL Server SA password (complexity rules: 8+ chars, upper, lower, digit, symbol)
MSSQL_SA_PASSWORD=Change_Me_123!
# Base URL of the employer-supplied SMS provider simulator, as seen from inside the api container
SMS_PROVIDER_URL=http://host.docker.internal:5005
# Optional: provider endpoint paths, relative to SMS_PROVIDER_URL. Leave empty for the defaults
# (send, status/{id}). The status path must contain {id}.
SMS_PROVIDER_SEND_PATH=
SMS_PROVIDER_STATUS_PATH=
